# barlink-sm86: allow non-root BAR1 P2P access.
# 1. dmabuf_holder misc device (module hardcodes mode 0600)
SUBSYSTEM=="misc", KERNEL=="dmabuf_holder", MODE="0666"

# 2. PCI BAR1 sysfs resource (kernel hardcodes mode 0600; mmap itself
#    has no CAP_SYS_RAWIO check, chmod is sufficient)
SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", RUN+="/bin/chmod a+rw /sys/bus/pci/devices/%k/resource1_wc"
